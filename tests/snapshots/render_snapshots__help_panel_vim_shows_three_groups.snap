"                                                                                "
"                                                                                "
"                                      Keys                                      "
"                                                                                "
"    Insert mode                                                                 "
"    ↑↓←→ Home End PgUp PgDn   Move the cursor                                   "
"    Ctrl+← / Ctrl+→           Previous / next word                              "
"    Ctrl+Home / Ctrl+End      Start / end of the document                       "
"    Shift+↑↓←→                Extend the selection (Shift + any move key)       "
"    Ctrl+Backspace / Ctrl+W   Delete the previous word                          "
"    Ctrl+A                    Select the whole body                             "
"    Ctrl+C / Ctrl+X / Ctrl+V  Copy / cut / paste (copies also via OSC 52)       "
"    Ctrl+Z / Ctrl+Y           Undo / redo                                       "
"    Esc                       Normal mode                                       "
"    Ctrl+S                    Save                                              "
"    Ctrl+Q                    Quit (twice if changes cannot be saved)           "
"    Ctrl+T                    Typewriter mode                                   "
"    Ctrl+F                    Focus mode                                        "
"    Ctrl+P                    Settings                                          "
"    Ctrl+G                    This list of keys                                 "
"                                                                                "
"    Normal mode                                                                 "
"    i                         Insert mode at the cursor                         "
"    a                         Insert mode after the cursor                      "
"    o                         Insert mode on a new line below                   "
"    v                         Start a selection                                 "
"    h                         Left                                              "
"    j                         Down a line                                       "
"    k                         Up a line (on the first line: into the title)     "
"    l                         Right                                             "
"    w                         Start of the next word                            "
"    b                         Previous word                                     "
"    e                         End of the word                                   "
"    0                         Start of the screen line                          "
"    $                         End of the screen line                            "
"    gg                        Start of the document                             "
"    G                         End of the document                               "
"    x                         Delete the next character or the selection        "
"    dd                        Cut the whole line                                "
"    p                         Paste (a cut line goes below)                     "
"    u                         Undo                                              "
"    Ctrl+R                    Redo                                              "
"    ?                         This list of keys                                 "
"                                                                                "
"    Visual (selection)                                                          "
"    l                         Movement keys extend the selection                "
"    y                         Copy (also to the system clipboard via OSC 52)    "
"    d / x                     Cut                                               "
"    p                         Replace the selection with the register           "
"    v / Esc                   End the selection                                 "
"    i                         Insert mode at the cursor                         "
