"                                                                                "
"                                                                                "
"                                                                                "
"                                                                                "
"                                                                                "
"                                                                                "
"                                                                                "
"                                                                                "
"                                                                                "
"                                                                                "
"                                                                                "
"                                      Keys                                      "
"                                                                                "
"    Insert mode                                                                 "
"    Enter                    New line (in the title: go to the body)            "
"    Backspace                Delete the previous character or the selection     "
"    Delete                   Delete the next character or the selection         "
"    Ctrl+Backspace / Ctrl+W  Delete the previous word                           "
"    Tab                      Insert spaces (tab width)                          "
"    ←                        Left                                               "
"    →                        Right                                              "
"    ↑                        Up a line (on the first line: into the title)      "
"    ↓                        Down a line                                        "
"    Ctrl+← / Alt+B           Previous word                                      "
"    Ctrl+→ / Alt+F           Next word                                          "
"    Home                     Start of the screen line                           "
"    End                      End of the screen line                             "
"    PageUp                   Page up                                            "
"    PageDown                 Page down                                          "
"    Ctrl+Home                Start of the document                              "
"    Ctrl+End                 End of the document                                "
"    Shift+→                  Extend the selection (Shift + any move key)        "
"    Ctrl+A                   Select the whole body                              "
"    Ctrl+C                   Copy (also to the system clipboard via OSC 52)     "
"    Ctrl+X                   Cut                                                "
"    Ctrl+V                   Paste from the internal register                   "
"    Ctrl+Z                   Undo                                               "
"    Ctrl+Y                   Redo                                               "
"    Esc                      Normal mode                                        "
"    Ctrl+S                   Save                                               "
"    Ctrl+Q                   Quit (twice if changes cannot be saved)            "
"    Ctrl+T                   Typewriter mode                                    "
"    Ctrl+F                   Focus mode                                         "
"    Ctrl+P                   Settings                                           "
"    Ctrl+G                   This list of keys                                  "
"                                                                                "
"    Normal mode                                                                 "
"    i                        Insert mode at the cursor                          "
"    a                        Insert mode after the cursor                       "
"    o                        Insert mode on a new line below                    "
"    v                        Start a selection                                  "
"    h                        Left                                               "
"    j                        Down a line                                        "
"    k                        Up a line (on the first line: into the title)      "
"    l                        Right                                              "
"    w                        Start of the next word                             "
"    b                        Previous word                                      "
"    e                        End of the word                                    "
"    0                        Start of the screen line                           "
"    $                        End of the screen line                             "
"    gg                       Start of the document                              "
"    G                        End of the document                                "
"    x                        Delete the next character or the selection         "
"    dd                       Cut the whole line                                 "
"    p                        Paste (a cut line goes below)                      "
"    u                        Undo                                               "
"    Ctrl+R                   Redo                                               "
"    ?                        This list of keys                                  "
"                                                                                "
"    Visual (selection)                                                          "
"    l                        Movement keys extend the selection                 "
"    y                        Copy (also to the system clipboard via OSC 52)     "
"    d / x                    Cut                                                "
"    p                        Replace the selection with the register            "
"    v / Esc                  End the selection                                  "
"    i                        Insert mode at the cursor                          "
"                                                                                "
"                                                                                "
"    ↑↓ scroll  Esc close                                                        "
"                                                                                "
