---
source: tests/render_snapshots.rs
expression: "format!(\"{}\\n{}\", styled(&b), snapshot(b.clone()))"
---
 1: "notes" DIM
 3: "  段 落" NONE
 5: "────────────────────" DIM
 6: "────────────────────" DIM
 8: "  后 文" NONE
10: "notes.md" DIM | "4 字" DIM | " · 1:1" DIM

"                        "
"         notes          "
"                        "
"  段落                  " Hidden by multi-width symbols: [(3, " "), (5, " ")]
"                        "
"  ────────────────────  "
"  ────────────────────  "
"                        "
"  后文                  " Hidden by multi-width symbols: [(3, " "), (5, " ")]
"                        "
"  notes.md  4 字 · 1:1  " Hidden by multi-width symbols: [(15, " ")]
"                        "

cursor: Position { x: 2, y: 3 } visible: true
